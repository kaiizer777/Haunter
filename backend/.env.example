# Database Connection (Neon Postgres)
DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-REPLACE_ME-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:REPLACE_ME@ep-REPLACE_ME.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# GitHub OAuth App (login only — read:user scope; separate from GitHub App for repo/webhooks)
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME

# Hardcoded redirect_uri — must match exactly what's registered in the GitHub OAuth App.
# Never derived from request Host header. For prod it MUST be:
#   https://a5fc7vxbwpvggzaossrtzy67ua0yerrb.lambda-url.us-east-1.on.aws/auth/callback
# (no truncation, exact match in GitHub OAuth App settings). Local dev: http://localhost:8000/auth/callback
CALLBACK_URL=http://localhost:8000/auth/callback

# Session cookie signing key (itsdangerous) — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=REPLACE_ME

# Previous signing key for zero-downtime rotation — leave empty unless rotating keys.
# SESSION_SECRET_KEY_PREVIOUS=

# Fernet key for encrypting users.access_token at rest.
# REQUIRED for non-test environments — startup raises RuntimeError if unset.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Then paste the output here (a URL-safe base64-encoded 32-byte key):
TOKEN_ENCRYPTION_KEY=REPLACE_ME

# GitHub Webhook Secret (HMAC-SHA256 verification on POST /webhooks/github)
# Must match the secret configured in GitHub Webhooks / GitHub App.
# Separate from OAuth App credentials — least privilege principle.
GITHUB_WEBHOOK_SECRET=REPLACE_ME

# GitHub REST API Token (PAT or GitHub App Installation Token for log/diff retrieval)
# Used by backend/app/github_client.py — never logged, never persisted in DB.
GITHUB_TOKEN=REPLACE_ME

# Frontend origin for OAuth redirect + CORS — must be exact origin, no trailing slash.
# Local dev: http://localhost:3000
# Prod (Lambda env + terraform.tfvars + Cloudflare Pages): https://haunter-dfg.pages.dev
# Preview deployments: add https://*.haunter-dfg.pages.dev if needed — but CORS allow_origins
# must be updated in backend/main.py and infra/aws/lambda.tf accordingly.
FRONTEND_URL=http://localhost:3000

# Per-IP rate limit for auth endpoints (req/min). Default: 20.
# RATE_LIMIT_PER_MINUTE=20

# OpenCode Zen / LLM Provider Configuration (Phase 4)
# API key for OpenCode Zen (https://opencode.ai/zen/v1). Never logged or committed.
OPENCODE_ZEN_API_KEY=REPLACE_ME
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
DEFAULT_PROVIDER=opencode_zen
DEFAULT_MODEL=nemotron-3.5-lightning-free

# Optional admin user UUID string for global model config switcher (leave empty to allow authenticated users)
# ADMIN_USER_ID=

# GCP project ID for Cloud Build sandbox (Phase 7 — required when SANDBOX_PROVIDER=gcp)
# GCP_PROJECT_ID=REPLACE_ME

# GitHub App credentials (Phase 8 — for opening PRs)
# GITHUB_APP_ID=REPLACE_ME
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ─── Phase 13 — Sandbox Provider Selection ────────────────────────────────────
# Set to "gcp" (default) to use Cloud Build, or "aws" to use CodeBuild.
# SANDBOX_PROVIDER=gcp

# AWS CodeBuild adapter (required when SANDBOX_PROVIDER=aws)
# Deploy infra first: cd infra/aws && terraform apply
# Then copy the "codebuild_project_name" output here.
# AWS_CODEBUILD_PROJECT_NAME=haunter-sandbox
# AWS_REGION=us-east-1
# ──────────────────────────────────────────────────────────────────────────────
