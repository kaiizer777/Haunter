      "expected": "runner: step one failed"
    },
    {
      "id": "cr-only-lines",
      "why": "a lone CR also breaks a line",
      "input": "runner: step one failed\rstack: deep",
      "expected": "runner: step one failed"
    },
    {
      "id": "tabs-and-spaces",
      "why": "tabs and runs of spaces collapse to one space",
