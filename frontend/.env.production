# Production build environment. Loaded by `next build` (NODE_ENV=production) and
# compiled into the static bundle served by the Cloudflare Worker.
#
# Must match the Lambda env var FRONTEND_URL's origin, which drives the backend
# CORS allowlist (backend/main.py:64). If these two drift, the dashboard loads
# but every API call is rejected and login silently fails.
#
# The API base itself is the AWS Lambda Function URL:
NEXT_PUBLIC_API_URL=https://gjdbtzw5h36jhniqgdcxvhmjxu0tcjqr.lambda-url.us-east-1.on.aws
