# Broader Terraform variable file safety net (catches *.auto.tfvars,
# *.tfvars.json, and any tfvars in a future sub-path).
*.tfvars
*.tfvars.json
!*.tfvars.example

# Project root markdown files (ignore any .md file in project root except readme, license, redeploy, haunter)
/*.md
!/README.md
!/readme.md
!/LICENSE.md
!/license.md
!/redeploy.md
!/HAUNTER.md
!/haunter.md



