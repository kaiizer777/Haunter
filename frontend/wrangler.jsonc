{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haunter-ci-agent",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
