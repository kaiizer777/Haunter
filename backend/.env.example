# Database Connection (Neon Postgres)
DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-REPLACE_ME-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:REPLACE_ME@ep-REPLACE_ME.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# GitHub OAuth App (login only — read:user scope; separate from GitHub App for repo/webhooks)
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME

# Hardcoded redirect_uri — must match exactly what's registered in the GitHub OAuth App.
# Never derived from request Host header. For prod it MUST be:
#   https://a5fc7vxbwpvggzaossrtzy67ua0yerrb.lambda-url.us-east-1.on.aws/auth/callback
# (no truncation, exact match in GitHub OAuth App settings). Local dev: http://localhost:7555/auth/callback
CALLBACK_URL=http://localhost:7555/auth/callback

# Session cookie signing key (itsdangerous) — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=REPLACE_ME

# Previous signing key for zero-downtime rotation — leave empty unless rotating keys.
# SESSION_SECRET_KEY_PREVIOUS=

# Fernet key for encrypting users.access_token at rest.
# REQUIRED for non-test environments — startup raises RuntimeError if unset.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Then paste the output here (a URL-safe base64-encoded 32-byte key):
TOKEN_ENCRYPTION_KEY=REPLACE_ME

# GitHub Webhook Secret (HMAC-SHA256 verification on POST /webhooks/github)
# Must match the secret configured in GitHub Webhooks / GitHub App.
# Separate from OAuth App credentials — least privilege principle.
GITHUB_WEBHOOK_SECRET=REPLACE_ME

# GitHub REST API Token (PAT or GitHub App Installation Token for log/diff retrieval)
# Used by backend/app/github_client.py — never logged, never persisted in DB.
GITHUB_TOKEN=REPLACE_ME
GITHUB_AUDITOR_APP_ID=REPLACE_ME
GITHUB_AUDITOR_APP_PRIVATE_KEY=REPLACE_ME
AUDIT_SELF_INVOKE_SECRET=REPLACE_ME

# Webhook delivery retention (Feature 8 health log — see app/services/webhook_retention.py).
# ROW and PAYLOAD expire separately on purpose: the row is the audit record and costs
# ~100 bytes; the payload is the replay buffer, base64 of the raw body, and is ~99% of the
# bytes a delivery costs. Past the payload window the body is NULLed out and the row
# survives (reporting replayable=false); past the row window the row is deleted.
# The sweeper runs from .github/workflows/webhook-retention.yml, which POSTs to
# /webhooks/deliveries/retention-sweep with an HMAC token derived from
# AUDIT_SELF_INVOKE_SECRET — it does NOT need DATABASE_URL in CI.
# HAUNTER_WEBHOOK_PAYLOAD_RETENTION_DAYS=90      # matches the 90d traces range cap
# HAUNTER_WEBHOOK_ROW_RETENTION_DAYS=365          # must be >= the payload window
# HAUNTER_WEBHOOK_RETENTION_SWEEP_BATCH_SIZE=1000 # rows per batch (bounded statement)
# HAUNTER_WEBHOOK_RETENTION_SWEEP_MAX_BATCHES=20  # batches per sweep => 20k rows/sweep

# Frontend origin for OAuth redirect + CORS — must be exact origin, no trailing slash.
# Local dev: http://localhost:3011
# Prod (Lambda env + terraform.tfvars + Cloudflare Worker "haunter"): https://haunter.sufiyanx.workers.dev
# CORS allow_origins is derived from this value in backend/main.py (cors_origins), plus a
# localhost/127.0.0.1 counterpart when this is a local URL — nothing to hand-maintain.
FRONTEND_URL=http://localhost:3011

# Per-IP rate limit for auth endpoints (req/min). Default: 20.
# RATE_LIMIT_PER_MINUTE=20

# OpenCode Zen / LLM Provider Configuration (Phase 4)
# API key for OpenCode Zen (https://opencode.ai/zen/v1). Never logged or committed.
OPENCODE_ZEN_API_KEY=REPLACE_ME
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
DEFAULT_PROVIDER=opencode_zen
DEFAULT_MODEL=nemotron-3.5-lightning-free

# Groq LLM Provider Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=openai/gpt-oss-120b

# OpenAI Provider Configuration (Phase 3.2 Issue 3)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Provider Configuration (Phase 3.2 Issue 3)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# TinyFish API Configuration (Web Search, Stealth Fetch & Agent API)
TINYFISH_API_KEY=REPLACE_ME
TINYFISH_BASE_URL=https://api.tinyfish.io/v1
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai

# Optional admin user UUID string for global model config switcher (leave empty to allow authenticated users)
# ADMIN_USER_ID=

# GitHub App credentials (Phase 8 — for opening PRs)
# GITHUB_APP_ID=REPLACE_ME
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ─── Phase 13 — Sandbox Provider Selection ────────────────────────────────────
# Set to "github_actions" (default).
# SANDBOX_PROVIDER=github_actions
# GITHUB_SANDBOX_ORG=haunter-sandboxes
# GITHUB_SANDBOX_APP_ID=REPLACE_ME
# GITHUB_SANDBOX_INSTALLATION_ID=REPLACE_ME

# ─── Phase 14 — Hosting Provider Selection ────────────────────────────────────
# Set to "aws" (default: Lambda + Function URL).
# HOSTING_PROVIDER=aws
# AWS_LAMBDA_FUNCTION_NAME=haunter-orchestrator
# AWS_REGION=us-east-1
# ──────────────────────────────────────────────────────────────────────────────
