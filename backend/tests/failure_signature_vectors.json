    },
    {
      "id": "error-b",
      "why": "distinct failure",
      "input": "sandbox: TimeoutError: runner timed out",
      "expected": "sandbox: timeouterror: runner timed out"
    },
    {
      "id": "error-c",
      "why": "distinct failure",
      "input": "pr_writer: GitHubError 403 forbidden",
      "expected": "pr_writer: githuberror <n> forbidden"
    },
    {
      "id": "truncation",
      "why": "signature is truncated to MAX_SIGNATURE_CHARS counted in code points, so a non-BMP character sitting on the boundary is kept whole (a UTF-16 slice would split its surrogate pair)",
      "input": "pr_writer: rollout blocked at step pr_writer: rollout blocked at step pr_writer: rollout blocked at step pr_writer: rollout blocked at step pr_writer: rollout blocked at step pr_writer: rollout bloc 🚀 tail",
      "expected": "pr_writer: rollout blocked at step pr_writer: rollout blocked at step pr_writer: rollout blocked at step pr_writer: rollout blocked at step pr_writer: rollout blocked at step pr_writer: rollout bloc 🚀"
    },
    {
      "id": "crlf-lines",
      "why": "CRLF log lines break like LF",
