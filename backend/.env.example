# Database Connection (Neon Postgres)
DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-REPLACE_ME-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:REPLACE_ME@ep-REPLACE_ME.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# GitHub OAuth App (login only — read:user scope; separate from GitHub App for repo/webhooks)
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME

# Hardcoded redirect_uri — must match exactly what's registered in the GitHub OAuth App.
# Never derived from request Host header. Update this when deploying to prod.
CALLBACK_URL=http://localhost:8000/auth/callback

# Session cookie signing key (itsdangerous) — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=REPLACE_ME

# Previous signing key for zero-downtime rotation — leave empty unless rotating keys.
# SESSION_SECRET_KEY_PREVIOUS=

# Fernet key for encrypting users.access_token at rest — pre-prod security blocker if unset.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=

# GitHub Webhook Secret (HMAC-SHA256 verification on POST /webhooks/github)
# Must match the secret configured in GitHub Webhooks / GitHub App.
# Separate from OAuth App credentials — least privilege principle.
GITHUB_WEBHOOK_SECRET=REPLACE_ME

# GitHub REST API Token (PAT or GitHub App Installation Token for log/diff retrieval)
# Used by backend/app/github_client.py — never logged, never persisted in DB.
GITHUB_TOKEN=REPLACE_ME

# Frontend origin for OAuth redirect + CORS
FRONTEND_URL=http://localhost:3000

# Per-IP rate limit for auth endpoints (req/min). Default: 20.
# RATE_LIMIT_PER_MINUTE=20

